# Backend API URL
VITE_API_URL=http://localhost:5000

# Visitor analytics endpoint. Hostinger/PHP deploy uses /api/analytics.php.
VITE_ANALYTICS_API_URL=/api/analytics.php

# Hostinger/PHP blog storage endpoint.
VITE_BLOG_API_URL=/api/blog.php
VITE_BLOG_ADMIN_KEY=RivereBlog2026!

# Free heatmap/session tracking via Microsoft Clarity.
VITE_CLARITY_PROJECT_ID=
VITE_CLARITY_ENABLE_LOCAL=false

# Optional Hotjar heatmap/session tracking. Fill with Hotjar Site ID before production build.
VITE_HOTJAR_ID=
VITE_HOTJAR_SV=6
VITE_HOTJAR_ENABLE_LOCAL=false
VITE_CONTENTSQUARE_ENABLE_LOCAL=false
